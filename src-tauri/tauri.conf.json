{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexShell",
  "version": "0.1.4",
  "identifier": "com.codexshell.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodexShell",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
